rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Offers are public to read; only the shop edits them, in the Firebase console.
    match /offers/{offerId} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
